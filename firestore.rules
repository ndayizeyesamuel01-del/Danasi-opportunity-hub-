rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Platform collections accessible by application services and authenticated clients
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if false; // Only server backend can modify settings
    }

    match /opportunity_categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Only server backend can modify categories
    }

    match /users/{userId} {
      allow read: if false; // User credentials & password hashes are private to backend
      allow write: if false;
    }

    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if false; // Modifications must pass through backend API validation
    }

    match /user_preferences/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if false; // Audit logs are strictly server-managed
      allow write: if false;
    }

    match /contact_messages/{messageId} {
      allow read: if false;
      allow write: if false;
    }

    match /saved_items/{savedId} {
      allow read: if true;
      allow write: if false;
    }

    // DANASI JOBS Module Collections
    match /jobs/{jobId} {
      allow read: if true; // Public verified jobs discovery
      allow write: if false; // Job posting must pass through backend validation & moderation
    }

    match /employers/{employerId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_reports/{reportId} {
      allow read: if false;
      allow write: if false;
    }

    match /saved_jobs/{savedJobId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_applications/{applicationId} {
      allow read: if true;
      allow write: if false;
    }

    match /verification_records/{recordId} {
      allow read: if false;
      allow write: if false;
    }

    match /job_sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_sync_runs/{runId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_source_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
