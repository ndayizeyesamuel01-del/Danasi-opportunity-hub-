rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Platform collections accessible by application services
    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    match /opportunity_categories/{categoryId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /user_profiles/{userId} {
      allow read, write: if true;
    }

    match /user_preferences/{userId} {
      allow read, write: if true;
    }

    match /roles/{roleId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /audit_logs/{auditId} {
      allow read, write: if true;
    }

    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    match /saved_items/{savedId} {
      allow read, write: if true;
    }

    // DANASI JOBS Module Collections
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /employers/{employerId} {
      allow read, write: if true;
    }

    match /job_categories/{categoryId} {
      allow read, write: if true;
    }

    match /job_reports/{reportId} {
      allow read, write: if true;
    }

    match /saved_jobs/{savedJobId} {
      allow read, write: if true;
    }

    match /job_applications/{applicationId} {
      allow read, write: if true;
    }

    match /verification_records/{recordId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
