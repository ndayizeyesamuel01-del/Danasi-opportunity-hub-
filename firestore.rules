rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC READ-ONLY COLLECTIONS (Genuine opportunity & metadata discovery)
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if false; // Only backend API can modify settings
    }

    match /opportunity_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /jobs/{jobId} {
      allow read: if true; // Public verified jobs discovery
      allow write: if false; // Job posting must pass through backend API moderation
    }

    match /employers/{employerId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /job_sync_runs/{runId} {
      allow read: if true;
      allow write: if false;
    }

    // STRICTLY PROTECTED USER, SENSITIVE & PRIVATE COLLECTIONS
    // Direct client-side reads and writes are forbidden; all access must pass through backend API with ownership checks
    match /users/{userId} {
      allow read, write: if false;
    }

    match /user_profiles/{userId} {
      allow read, write: if false;
    }

    match /user_preferences/{userId} {
      allow read, write: if false;
    }

    match /roles/{roleId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /saved_items/{savedId} {
      allow read, write: if false;
    }

    match /saved_jobs/{savedJobId} {
      allow read, write: if false;
    }

    match /job_applications/{applicationId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /password_resets/{resetId} {
      allow read, write: if false;
    }

    match /audit_logs/{auditId} {
      allow read, write: if false;
    }

    match /contact_messages/{messageId} {
      allow read, write: if false;
    }

    match /job_reports/{reportId} {
      allow read, write: if false;
    }

    match /verification_records/{recordId} {
      allow read, write: if false;
    }

    match /job_source_logs/{logId} {
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
